<?xml version="1.0" encoding="utf-8"?>
<!-- res/layout/activity_main.xml -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💰"
            android:textSize="40sp"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Control de Gastos"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#1E293B"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Monitoreo automático de Bancolombia y Nequi"
            android:textSize="13sp"
            android:textColor="#64748B"
            android:layout_gravity="center"
            android:gravity="center"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="32dp"/>

        <!-- Estado: CONECTADO -->
        <LinearLayout
            android:id="@+id/statusConnected"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_green"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✅  Servicio activo"
                android:textStyle="bold"
                android:textColor="#0F6E56"
                android:textSize="15sp"/>

            <TextView
                android:id="@+id/tvServerUrlActive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#64748B"
                android:textSize="12sp"
                android:layout_marginTop="4dp"/>

            <Button
                android:id="@+id/btnDisconnect"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Desconectar"
                android:textSize="12sp"
                android:backgroundTint="#E2E8F0"
                android:textColor="#475569"
                android:layout_marginTop="12dp"/>
        </LinearLayout>

        <!-- Estado: DESCONECTADO -->
        <LinearLayout
            android:id="@+id/statusDisconnected"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_amber"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠️  Sin configurar"
                android:textStyle="bold"
                android:textColor="#854F0B"
                android:textSize="15sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Completa la configuración para empezar a monitorear tus gastos automáticamente."
                android:textColor="#92400E"
                android:textSize="13sp"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- Permiso de notificaciones -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Paso 1 — Permiso de notificaciones"
            android:textStyle="bold"
            android:textColor="#1E293B"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:id="@+id/permissionOk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:background="@drawable/bg_card_green"
            android:layout_marginBottom="16dp"
            android:visibility="gone">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="✅  Permiso concedido" android:textColor="#0F6E56" android:textSize="13sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/permissionNeeded"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:background="@drawable/bg_card"
            android:layout_marginBottom="8dp"
            android:visibility="gone">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Necesitas dar acceso a las notificaciones para que la app pueda leer los mensajes de Bancolombia y Nequi."
                android:textColor="#475569" android:textSize="13sp"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnPermission"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Abrir Ajustes de Notificaciones"
            android:backgroundTint="#1E293B"
            android:layout_marginBottom="24dp"/>

        <!-- Setup section -->
        <LinearLayout
            android:id="@+id/setupSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Paso 2 — Conectar con tu cuenta"
                android:textStyle="bold"
                android:textColor="#1E293B"
                android:textSize="14sp"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="URL del servidor"
                android:textColor="#64748B"
                android:textSize="12sp"
                android:layout_marginBottom="4dp"/>

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etServerUrl"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="https://tu-servidor.com"
                android:inputType="textUri"
                android:background="@drawable/bg_input"
                android:paddingHorizontal="12dp"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Email"
                android:textColor="#64748B"
                android:textSize="12sp"
                android:layout_marginBottom="4dp"/>

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="tu@correo.com"
                android:inputType="textEmailAddress"
                android:background="@drawable/bg_input"
                android:paddingHorizontal="12dp"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Contraseña"
                android:textColor="#64748B"
                android:textSize="12sp"
                android:layout_marginBottom="4dp"/>

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="••••••••"
                android:inputType="textPassword"
                android:background="@drawable/bg_input"
                android:paddingHorizontal="12dp"
                android:layout_marginBottom="16dp"/>

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Conectar y activar monitoreo"
                android:backgroundTint="#0F6E56"
                android:textSize="15sp"
                android:layout_marginBottom="16dp"/>
        </LinearLayout>

        <!-- Info bancos -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bancos monitoreados"
            android:textStyle="bold"
            android:textColor="#1E293B"
            android:textSize="14sp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🏦 Bancolombia App\n💚 Nequi\n🔵 Daviplata\n🟦 BBVA\n🔴 Davivienda"
            android:textColor="#475569"
            android:textSize="13sp"
            android:lineSpacingExtra="6dp"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="24dp"/>

    </LinearLayout>
</ScrollView>
