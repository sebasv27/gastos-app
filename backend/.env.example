# ── Base de datos ──────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/gastos_app"

# ── JWT ────────────────────────────────────────────────────────────────
JWT_SECRET="cambia_esto_por_un_string_largo_aleatorio_min_32_chars"
JWT_EXPIRES_IN="7d"

# ── Servidor ───────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"

# ── Claude AI (OCR recibos, OCR comidas, recomendaciones) ──────────────
# Obtén tu key en https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY="sk-ant-..."

# ── Email (alertas de presupuesto) ─────────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="tu@gmail.com"
SMTP_PASS="tu_app_password_gmail"
EMAIL_FROM="Control de Gastos <tu@gmail.com>"

# ── Imágenes de recetas (opcional, 100/día gratis) ─────────────────────
# https://console.cloud.google.com → Custom Search API
GOOGLE_CSE_KEY=
GOOGLE_CSE_ID=
